# BITX Attack Check configuration example
# Copy to /etc/bitx-attack-check.conf and adjust only what you need.

LOGDIR=/var/log/virtualmin
FIREWALL_ZONE=public

BLOCK_TIME=24h
BLOCK_HOURS=24

# Comma-separated trusted IP addresses.
IGNORE_IPS=127.0.0.1,::1

SCAN_LIMIT=5
SCAN_WITH_4XX_LIMIT=2
SCAN_4XX_MIN=20
WP_LIMIT=20
