    )

    print("-" * 80)

    for ip in sorted(
        active_ips,
        key=lambda x: (
            ipaddress.ip_address(x).version,
            int(ipaddress.ip_address(x))
        )
    ):

        info = state.get(ip)

        if info:

            try:

                expires = (
                    datetime.fromisoformat(
                        info["expires"]
                    )
                )

                remaining = (
                    remaining_time(
                        expires
                    )
                )

            except Exception:

                remaining = "?"

            reason = info.get(
                "reason",
                "-"
            )

        else:

            remaining = "?"
            reason = "pre-existing"

        print(
            f"{ip:39} "
            f"{remaining:>10}  "
            f"{reason}"
        )

