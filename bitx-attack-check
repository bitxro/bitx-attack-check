        f"⏱️ <b>Durata:</b> <code>{duration_label}</code>\n"
        f"🔁 <b>Recidiva:</b> <code>{recurrence}</code>\n"
        f"⚠️ <b>Motiv:</b> <code>{reason}</code>\n"
        "🔴 <b>AUTO-BLOCK</b>"
    )
    return telegram_send(message)


