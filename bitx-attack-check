        "hard": 0,
        "wp": 0,
        "4xx": 0,
        "5xx": 0,
        "domains": set(),
    }
)


for (
    domain,
    ip
), s in stats.items():

    g = global_stats[ip]

    g["total"] += s["total"]
    g["hard"] += s["hard"]
    g["wp"] += s["wp"]
    g["4xx"] += s["4xx"]
    g["5xx"] += s["5xx"]

    g["domains"].add(
        domain
    )


# ============================================================
# AUTO BLOCK
# ============================================================

print()
print(
    "===== DECIZII AUTO-BLOCK ====="
)

candidates = []


for ip, s in global_stats.items():

    if ip in IGNORE_IPS:
        continue

    if not valid_ip(ip):
        continue

    reasons = []

    if s["hard"] >= BLOCK_SCAN:

        reasons.append(
            f"SCAN={s['hard']}"
        )

    elif (
        s["hard"]
        >= BLOCK_SCAN_WITH_4XX
        and
        s["4xx"]
        >= BLOCK_SCAN_4XX_MIN
    ):

        reasons.append(
            f"SCAN={s['hard']}"
            f"+4XX={s['4xx']}"
        )

    if s["wp"] >= BLOCK_WP:

        reasons.append(
            f"WP={s['wp']}"
        )

    if reasons:

        candidates.append(
            (
                ip,
                s,
                ",".join(reasons)
            )
        )


if not candidates:

    print(
        "Niciun IP nu indeplineste "
        "criteriile de autoblock."
    )

else:

    candidates.sort(
        key=lambda x: (
            x[1]["hard"],
            x[1]["wp"],
            x[1]["total"]
        ),
        reverse=True
    )

    print(
        f"{'IP':39} "
        f"{'REQ':>6} "
        f"{'SCAN':>6} "
        f"{'WP':>5} "
        f"{'4XX':>6}  "
        f"{'ACTION':18} "
        f"REASON"
    )

    print("-" * 110)

    for (
        ip,
        s,
        reason
    ) in candidates:

        if block_mode:

            changed, action = (
                firewall_block(
                    ip,
                    reason
                )
            )

        else:

            action = crawler_protection(ip) or "WOULD-BLOCK"

        print(
            f"{ip[:39]:39} "
            f"{s['total']:6} "
            f"{s['hard']:6} "
            f"{s['wp']:5} "
            f"{s['4xx']:6}  "
            f"{action:18} "
            f"{reason}"
        )


