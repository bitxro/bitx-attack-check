def access_datetime(line):

    m = re.search(
        r'\[(\d{2})/([A-Za-z]{3})/(\d{4}):'
        r'(\d{2}):(\d{2}):(\d{2}) [+-]\d{4}\]',
        line
    )

    if not m:
        return None

    d, mon, y, hh, mm, ss = m.groups()

    try:

        return datetime(
            int(y),
            MONTHS[mon],
            int(d),
            int(hh),
            int(mm),
            int(ss)
        )

    except Exception:
        return None


def error_datetime(line):

    m = re.match(
        r'^\[[A-Za-z]{3} ([A-Za-z]{3}) +(\d{1,2}) '
        r'(\d{2}):(\d{2}):(\d{2})(?:\.\d+)? (\d{4})\]',
        line
    )

    if not m:
        return None

    mon, d, hh, mm, ss, y = m.groups()

    try:

        return datetime(
            int(y),
            MONTHS[mon],
            int(d),
            int(hh),
            int(mm),
            int(ss)
        )

    except Exception:
        return None


def domain_from_file(path, marker):

    name = os.path.basename(path)

    return name.split(marker)[0]


def client_from_error(line):

    m = re.search(
        r'\[client ([^\]]+)\]',
        line
    )

    if not m:
        return "-"

    value = m.group(1)

    if re.match(
        r'^\d+\.\d+\.\d+\.\d+:\d+$',
        value
    ):
        return value.rsplit(":", 1)[0]

    return value


