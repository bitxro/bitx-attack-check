def save_state(state):

    os.makedirs(
        STATE_DIR,
        mode=0o700,        exist_ok=True
    )

    tmp = STATE_FILE + ".tmp"

    with open(
        tmp,
        "w"
    ) as fh:

        json.dump(
            state,
            fh,
            indent=2,
            sort_keys=True
        )

    os.chmod(
        tmp,
        0o600
    )

    os.replace(
        tmp,
        STATE_FILE
    )


def load_history():
    try:
        with open(HISTORY_FILE, "r") as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            return data
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        pass
