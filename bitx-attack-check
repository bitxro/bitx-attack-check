def load_state():

    try:

        with open(
            STATE_FILE,
            "r"
        ) as fh:

            data = json.load(fh)

        if isinstance(data, dict):
            return data

    except (
        FileNotFoundError,
        json.JSONDecodeError,
        OSError
    ):
        pass

    return {}


def save_state(state):

    os.makedirs(
        STATE_DIR,
        mode=0o700,
        exist_ok=True
    )

    tmp = STATE_FILE + ".tmp"

    with open(
        tmp,
        "w"
    ) as fh:

        json.dump(
            state,
            fh,
            indent=2,
            sort_keys=True
        )

    os.chmod(
        tmp,
        0o600
    )

    os.replace(
        tmp,
        STATE_FILE
    )


def register_block(ip, reason):

    state = load_state()

    blocked = datetime.now()

    expires = blocked + timedelta(
        hours=BLOCK_HOURS
    )

    state[ip] = {
        "blocked":
            blocked.isoformat(
                timespec="seconds"
            ),

        "expires":
            expires.isoformat(
                timespec="seconds"
            ),

        "reason":
            reason,
    }

    save_state(state)


def remove_state_block(ip):

    state = load_state()

    if ip in state:

        del state[ip]

        save_state(state)


def remaining_time(expires):

    seconds = int(
        (
            expires
            - datetime.now()
        ).total_seconds()
    )

    if seconds <= 0:
        return "expired"

    hours, rem = divmod(
        seconds,
        3600
    )

    minutes = rem // 60

    if hours:
        return f"{hours}h {minutes:02}m"

    return f"{minutes}m"


