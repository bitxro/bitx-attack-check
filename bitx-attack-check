def run_firewall(args):

    try:

        result = subprocess.run(
            ["firewall-cmd"] + args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=20
        )

        return (
            result.returncode,
            result.stdout.strip(),
            result.stderr.strip()
        )

    except Exception as e:

        return 1, "", str(e)


def firewall_rule(ip):

    obj = ipaddress.ip_address(ip)

    family = (
        "ipv4"
        if obj.version == 4
        else "ipv6"
    )

    return (
        f'rule family="{family}" '
        f'source address="{ip}" drop'
    )


def firewall_block(ip, reason):

    if ip in IGNORE_IPS:
        return False, "WHITELIST"

    if not valid_ip(ip):
        return False, "INVALID-IP"

    rule = firewall_rule(ip)

    rc, out, err = run_firewall([
        f"--zone={FIREWALL_ZONE}",
        "--query-rich-rule",
        rule
    ])

    if rc == 0:
        return False, "ALREADY-BLOCKED"

    rc, out, err = run_firewall([
        f"--zone={FIREWALL_ZONE}",
        "--add-rich-rule",
        rule,
        f"--timeout={BLOCK_TIME}"
    ])

    if rc == 0:

        register_block(
            ip,
            reason
        )

        telegram_send_ok, telegram_send_msg = telegram_block_notification(
            ip,
            reason
        )

        if TELEGRAM_ENABLED and not telegram_send_ok:
            print(
                f"[WARN] Telegram notification failed for {ip}: "
                f"{telegram_send_msg}",
                file=sys.stderr
            )

        return (
            True,
            f"BLOCKED-{BLOCK_TIME}"
        )

    return (
        False,
        f"ERROR: {err or out}"
    )


def firewall_unblock(ip):

    if not valid_ip(ip):
        return False, "INVALID-IP"

    rule = firewall_rule(ip)

    rc, out, err = run_firewall([
        f"--zone={FIREWALL_ZONE}",
        "--remove-rich-rule",
        rule
    ])

    if rc == 0:

        remove_state_block(ip)

        return True, "UNBLOCKED"

    return (
        False,
        err or out or "NOT-BLOCKED"
    )


def get_active_blocked_ips():

    rc, out, err = run_firewall([
        f"--zone={FIREWALL_ZONE}",
        "--list-rich-rules"
    ])

    if rc != 0:
        return None, err

    active = set()

    for line in out.splitlines():

        if (
            "source address=" not in line
            or " drop" not in line
        ):
            continue

        m = re.search(
            r'source address="([^"]+)"',
            line
        )

        if m:
            active.add(
                m.group(1)
            )

    return active, None


def show_blocked():

    active_ips, err = (
        get_active_blocked_ips()
    )

    if active_ips is None:

        print(
            f"Eroare firewalld: {err}"
        )

        return

    state = load_state()

    changed = False

    for ip in list(state):

        if ip not in active_ips:

            del state[ip]

            changed = True

    if changed:
        save_state(state)

    print()
    print(
        "===== BITX ACTIVE BLOCKS ====="
    )
    print()

    if not active_ips:

        print(
            "Niciun IP blocat momentan."
        )

        print()

        return

    print(
        f"{'IP':39} "
        f"{'REMAINING':>10}  "
