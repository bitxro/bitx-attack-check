def remove_whitelist_ip():
    ip = input("IP de eliminat: ").strip()

    if not valid_ip(ip):
        print("IP invalid.")
        input("Enter pentru continuare...")
        return

    try:
        with open(CONFIG_FILE, "r") as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        print("Fisierul de configurare nu exista.")
        input("Enter pentru continuare...")
        return

    new_lines = []
    removed = False

    for line in lines:
        stripped = line.strip()

        if stripped.startswith("IGNORE_IP="):
            value = stripped.split("=", 1)[1]
            entry_ip = value.partition("|")[0].strip()

            if entry_ip == ip:
                removed = True
                continue

        new_lines.append(line)

    if not removed:
        print("IP-ul nu exista ca intrare IGNORE_IP in config.")
        input("Enter pentru continuare...")
        return

    tmp = CONFIG_FILE + ".tmp"

    with open(tmp, "w") as fh:
        fh.writelines(new_lines)

    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG_FILE)

    print(f"Eliminat din whitelist: {ip}")
    input("Enter pentru continuare...")




def export_whitelist(path):
    entries = [{"ip": ip, "description": IGNORE_IP_DESCRIPTIONS.get(ip, "-")} for ip in sorted(IGNORE_IPS)]
    payload = {"format": "bitx-attack-check-whitelist", "version": 1, "exported_from": socket.gethostname(), "entries": entries}
    with open(path, "w") as fh:
        json.dump(payload, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.chmod(path, 0o600)
    return len(entries)


def import_whitelist(path):
    try:
        with open(path, "r") as fh:
            payload = json.load(fh)
    except (OSError, json.JSONDecodeError) as e:
        return False, 0, 0, 0, str(e)
    if not isinstance(payload, dict) or payload.get("format") != "bitx-attack-check-whitelist" or not isinstance(payload.get("entries"), list):
        return False, 0, 0, 0, "format de export invalid"
    existing = set(IGNORE_IPS)
    additions = []
    duplicates = invalid = 0
    for item in payload["entries"]:
        if not isinstance(item, dict):
            invalid += 1
            continue
        ip = str(item.get("ip", "")).strip()
        description = str(item.get("description", "-")).strip() or "-"
        if not valid_ip(ip):
            invalid += 1
        elif ip in existing:
            duplicates += 1
        else:
            additions.append((ip, description))
            existing.add(ip)
    if additions:
        needs_newline = False
        try:
            with open(CONFIG_FILE, "rb") as fh:
                data = fh.read()
                needs_newline = bool(data and not data.endswith(b"\n"))
        except FileNotFoundError:
            pass
        with open(CONFIG_FILE, "a") as fh:
            if needs_newline:
                fh.write("\n")
            for ip, description in additions:
                fh.write(f"IGNORE_IP={ip}|{description}\n")
        os.chmod(CONFIG_FILE, 0o600)
    return True, len(additions), duplicates, invalid, ""



def update_config_values(updates):
    try:
        with open(CONFIG_FILE, "r") as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        lines = []

    remaining = dict(updates)
    new_lines = []

    for line in lines:
        stripped = line.strip()

        if "=" in stripped and not stripped.startswith("#"):
            key = stripped.split("=", 1)[0].strip()

            if key in remaining:
                new_lines.append(f"{key}={remaining.pop(key)}\n")
                continue

        new_lines.append(line)

    if new_lines and not new_lines[-1].endswith("\n"):
        new_lines[-1] += "\n"

    for key, value in remaining.items():
        new_lines.append(f"{key}={value}\n")

    tmp = CONFIG_FILE + ".tmp"

    with open(tmp, "w") as fh:
        fh.writelines(new_lines)

    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG_FILE)


