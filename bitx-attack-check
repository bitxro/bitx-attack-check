def load_config():

    config = {}
    repeated = defaultdict(list)

    try:
        with open(CONFIG_FILE, "r") as fh:

            for line in fh:

                line = line.strip()

                if (
                    not line
                    or line.startswith("#")
                    or "=" not in line
                ):
                    continue

                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip()

                if key == "IGNORE_IP":
                    repeated[key].append(value)
                else:
                    config[key] = value

    except FileNotFoundError:
        pass

    config.update(repeated)
    return config


