def save_history(history):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = HISTORY_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(history, fh, indent=2, sort_keys=True)
    os.chmod(tmp, 0o600)
    os.replace(tmp, HISTORY_FILE)


def next_ban(ip):
    history = load_history()
    now = datetime.now()
    info = history.get(ip, {})
    count = 0

    try:
        last_blocked = datetime.fromisoformat(info.get("last_blocked", ""))
        if now - last_blocked <= timedelta(days=HISTORY_RESET_DAYS):
            count = int(info.get("count", 0))
    except (ValueError, TypeError):
        pass

    recurrence = count + 1
    level = min(recurrence - 1, len(BAN_LEVELS) - 1)
    hours, label = BAN_LEVELS[level]
    return hours, label, recurrence


def register_history_block(ip, recurrence):
    history = load_history()
    history[ip] = {
        "count": recurrence,
        "last_blocked": datetime.now().isoformat(timespec="seconds"),
    }
    save_history(history)


def register_block(ip, reason, block_hours, duration_label, recurrence):

    state = load_state()

    blocked = datetime.now()

    expires = blocked + timedelta(
        hours=block_hours
    )

    state[ip] = {
        "blocked": blocked.isoformat(timespec="seconds"),
        "expires": expires.isoformat(timespec="seconds"),
        "reason": reason,
        "duration": duration_label,
        "recurrence": recurrence,
    }

    save_state(state)


def remove_state_block(ip):

    state = load_state()

    if ip in state:

        del state[ip]

        save_state(state)


def remaining_time(expires):

    seconds = int(
        (
            expires
            - datetime.now()
        ).total_seconds()
    )

    if seconds <= 0:
        return "expired"

    hours, rem = divmod(
        seconds,
        3600
    )

    minutes = rem // 60

    if hours:
        return f"{hours}h {minutes:02}m"

    return f"{minutes}m"


