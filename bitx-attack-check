def prompt_minutes(default=15):
    value = input(f"Minute [{default}]: ").strip()

    if not value:
        return default

    try:
        minutes = int(value)
        if minutes <= 0:
            raise ValueError
        return minutes
    except ValueError:
        print("Valoare invalida. Folosesc valoarea implicita.")
        return default


def add_whitelist_ip():
    ip = input("IP de adaugat: ").strip()

    if not valid_ip(ip):
        print("IP invalid.")
        input("Enter pentru continuare...")
        return

    if ip in IGNORE_IPS:
        print("IP-ul este deja in whitelist.")
        input("Enter pentru continuare...")
        return

    description = input("Descriere: ").strip() or "-"

    os.makedirs(APP_DIR, exist_ok=True)

    needs_newline = False
    try:
        with open(CONFIG_FILE, "rb") as fh:
            data = fh.read()
            needs_newline = bool(data and not data.endswith(b"\n"))
    except FileNotFoundError:
        pass

    with open(CONFIG_FILE, "a") as fh:
        if needs_newline:
            fh.write("\n")
        fh.write(f"IGNORE_IP={ip}|{description}\n")

    print(f"Adaugat: {ip} | {description}")
    input("Enter pentru continuare...")


def remove_whitelist_ip():
    ip = input("IP de eliminat: ").strip()

    if not valid_ip(ip):
        print("IP invalid.")
        input("Enter pentru continuare...")
        return

    try:
        with open(CONFIG_FILE, "r") as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        print("Fisierul de configurare nu exista.")
        input("Enter pentru continuare...")
        return

    new_lines = []
    removed = False

    for line in lines:
        stripped = line.strip()

        if stripped.startswith("IGNORE_IP="):
            value = stripped.split("=", 1)[1]
            entry_ip = value.partition("|")[0].strip()

            if entry_ip == ip:
                removed = True
                continue

        new_lines.append(line)

    if not removed:
        print("IP-ul nu exista ca intrare IGNORE_IP in config.")
        input("Enter pentru continuare...")
        return

    tmp = CONFIG_FILE + ".tmp"

    with open(tmp, "w") as fh:
        fh.writelines(new_lines)

    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG_FILE)

    print(f"Eliminat din whitelist: {ip}")
    input("Enter pentru continuare...")



def update_config_values(updates):
    try:
        with open(CONFIG_FILE, "r") as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        lines = []

    remaining = dict(updates)
    new_lines = []

    for line in lines:
        stripped = line.strip()

        if "=" in stripped and not stripped.startswith("#"):
            key = stripped.split("=", 1)[0].strip()

            if key in remaining:
                new_lines.append(f"{key}={remaining.pop(key)}\n")
                continue

        new_lines.append(line)

    if new_lines and not new_lines[-1].endswith("\n"):
        new_lines[-1] += "\n"

    for key, value in remaining.items():
        new_lines.append(f"{key}={value}\n")

    tmp = CONFIG_FILE + ".tmp"

    with open(tmp, "w") as fh:
        fh.writelines(new_lines)

    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG_FILE)


