# ============================================================

for logfile in glob.glob(
    f"{LOGDIR}/*_access_log*"
):

    domain = domain_from_file(
        logfile,
        "_access_log"
    )

    if (
        domain_filter
        and domain != domain_filter
    ):
        continue

    try:

        if os.path.getmtime(
            logfile
        ) < (
            cutoff
            - timedelta(days=2)
        ).timestamp():
            continue

    except OSError:
        continue

    try:
        fh = open_log(logfile)

    except Exception:
        continue

    with fh:

        for line in fh:

            dt = access_datetime(line)

            if (
                not dt
                or dt < cutoff
            ):
                continue

            parts = line.split()

            if not parts:
                continue

            ip = parts[0]

            req = re.search(
                r'"(?:GET|POST|HEAD|PUT|DELETE|OPTIONS|PATCH) ([^ ]+)',
                line
            )

            status_match = re.search(
                r'"\s+(\d{3})\s',
                line
            )

            target = (
                req.group(1)
                if req
                else "/"
            )

            try:

                path = urlsplit(
                    target
                ).path

            except Exception:

                path = target

            low = path.lower()

            status = (
                int(
                    status_match.group(1)
                )
                if status_match
                else 0
            )

            key = (
                domain,
                ip
            )

            stats[key]["total"] += 1

            if 400 <= status <= 499:
                stats[key]["4xx"] += 1

            if 500 <= status <= 599:
                stats[key]["5xx"] += 1

            hard = any(
                low == p
                or low.startswith(p)
                for p in HARD_PATTERNS
            )

            if hard:

                stats[key]["hard"] += 1

                paths[
                    (
                        domain,
                        ip,
                        low
                    )
                ] += 1

            if low in WP_PROBES:

                stats[key]["wp"] += 1

                paths[
